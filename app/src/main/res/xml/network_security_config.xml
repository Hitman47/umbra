<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain HTTP allowed: NAS on the home network or the tailnet serve WebDAV
    without TLS (ZimaOS: http://<nas>:5005). Tailscale encrypts remote traffic.
    The internet services (TMDB, TheTVDB, Trakt, GitHub) are reached in HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
